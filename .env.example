# Variables build Android (Capacitor — atelier Keyce)
APP_NAME=Life OS
APP_ID=com.lifeos.app
NODE_VERSION=22
ANDROID_SDK_VERSION=34
NEXT_PUBLIC_API_URL=https://life-os-platform.onrender.com/api

# Variables backend / Docker (docker-compose.yml racine)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=lifeos_db
DATABASE_URL=postgresql://postgres:your_password@postgres:5432/lifeos_db
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password
